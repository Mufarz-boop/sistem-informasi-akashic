# Salin file ini menjadi app/.env lalu isi nilainya.
# JANGAN commit file .env.

FLASK_ENV=development
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_HOST=127.0.0.1
APP_PORT=5000
# URL publik (dipakai untuk tautan reset password), contoh https://akashic.example.id
PUBLIC_BASE_URL=
# Email tujuan formulir kontak publik
CONTACT_EMAIL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_akashic
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5

SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=120
# Daftar origin lain yang boleh memanggil API (pisahkan dengan koma). Kosongkan jika frontend dilayani Flask.
CORS_ORIGINS=

# Web Push. Buat pasangan kunci dengan: python manage.py generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

NEWS_COLLECTOR_ENABLED=true
NEWS_COLLECT_INTERVAL_MINUTES=15
NEWS_REQUEST_TIMEOUT=15
NEWS_MAX_ITEMS_PER_SOURCE=30

LOCATION_MAX_ACCURACY_METERS=50000

PASSWORD_RESET_TOKEN_MINUTES=30
# SMTP opsional untuk email reset password
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_SENDER=
