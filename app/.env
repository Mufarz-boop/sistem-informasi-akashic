# ═══════════════════════════════════════════════════════════════
#  🌌 AKASHIC — Environment Template
#  Salin file ini ke .env dan isi nilainya.
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── APPLICATION ───────────────────────────────────────────────
APP_NAME=Akashic
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=5000
APP_URL=http://localhost:5000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID
SECRET_KEY=

# ─── DATABASE ──────────────────────────────────────────────────
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_akashic
DB_USER=root
DB_PASSWORD=razitanurin
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DATABASE_URL=

# ─── AUTH ──────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
SESSION_COOKIE_NAME=akashic_session
SESSION_COOKIE_SECURE=False
PASSWORD_HASH_METHOD=bcrypt
BCRYPT_ROUNDS=12

# ─── GEOLOCATION ───────────────────────────────────────────────
DEFAULT_LATITUDE=-6.2088
DEFAULT_LONGITUDE=106.8456
DEFAULT_REGION_CODE=ID
GEO_MAX_ACCURACY_METERS=5000
REGION_ENGINE_CACHE_TTL=3600
REGION_POLYGON_SRID=4326

# ─── NEWS COLLECTOR ────────────────────────────────────────────
NEWS_COLLECTOR_ENABLED=True
NEWS_COLLECTOR_INTERVAL_MINUTES=30
NEWS_RELEVANCE_THRESHOLD=0.65
NEWS_SOURCES=
NEWS_RSS_FEEDS=

# ─── FEED ──────────────────────────────────────────────────────
FEED_DEFAULT_LIMIT=20
FEED_MAX_LIMIT=100
FEED_CACHE_TTL=300

# ─── PUSH NOTIFICATION ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@akashic.local
PUSH_ENABLED=True

# ─── CORS ──────────────────────────────────────────────────────
CORS_ENABLED=True
CORS_ORIGINS=http://localhost:5000

# ─── UPLOAD ────────────────────────────────────────────────────
UPLOAD_FOLDER=./frontend/assets/image/uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,svg

# ─── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=./logs/akashic.log

# ─── EMAIL ─────────────────────────────────────────────────────
MAIL_ENABLED=False
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── TESTING ───────────────────────────────────────────────────
TESTING=False
TEST_DATABASE_URL=